<launch>
    <!-- config 参数可换配置: 默认 mapping.yaml(KITTI), 221港口数据用
         roslaunch voxel_plus mapping.launch config:=$(find voxel_plus)/config/mapping_port.yaml -->
    <arg name="config" default="$(find voxel_plus)/config/mapping.yaml" />
    <node pkg="voxel_plus" type="lio_node" name="lio_node" output="screen">
        <rosparam command="load" file="$(arg config)" />
    </node>
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find voxel_plus)/rviz/default.rviz" />
</launch>