<launch>
    <!-- KITTI: 这个 bag 没有 IMU 测量, 先把 /pose_imu 的位姿合成成 100Hz IMU -->
    <node pkg="voxel_plus" type="pose_to_imu" name="pose_to_imu" output="screen">
        <param name="pose_topic" value="/pose_imu" />
        <param name="imu_topic" value="/synthetic_imu" />
        <param name="imu_frame" value="imu" />
        <param name="rate" value="100.0" />
        <param name="poly_win" value="5" />
    </node>

    <node pkg="voxel_plus" type="lio_node" name="lio_node" output="screen">
        <rosparam command="load" file="$(find voxel_plus)/config/mapping.yaml" />
    </node>

    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find voxel_plus)/rviz/default.rviz" />
</launch>
