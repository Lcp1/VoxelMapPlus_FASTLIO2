<!-- 完整系统启动文件: 前端 LIO + 后端回环/位姿图优化 + rviz -->
<launch>
    <!-- 前端: 体素平面 LIO, 发布 slam_odom / world_cloud / cloud_with_odom 等话题 -->
    <node pkg="voxel_plus" type="lio_node" name="lio_node" output="screen">
        <rosparam command="load" file="$(find voxel_plus)/config/mapping.yaml" />
    </node>
    <!-- 后端: 订阅前端的 cloud_with_odom 做 STD 回环检测与 GTSAM 位姿图优化 -->
    <!-- 注意这里加载的是 std_matcher 自己的 config.yaml, 不是前端的 mapping.yaml -->
    <node pkg="std_matcher" type="pgo_node" name="pgo_node" output="screen">
        <rosparam command="load" file="$(find std_matcher)/config/config.yaml" />
    </node>
    <!-- 可视化; nice 降低优先级, 避免 rviz 抢占主线程 CPU -->
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find voxel_plus)/rviz/default.rviz" />

</launch>